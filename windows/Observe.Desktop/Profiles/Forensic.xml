<Sysmon schemaversion="4.82">
  <HashAlgorithms>sha256</HashAlgorithms><DnsLookup>False</DnsLookup>
  <EventFiltering><RuleGroup name="Observe forensic" groupRelation="or">
    <ProcessCreate onmatch="exclude"/><ProcessTerminate onmatch="exclude"/>
    <NetworkConnect onmatch="exclude"/><DnsQuery onmatch="exclude"/>
    <FileCreate onmatch="exclude"/><RegistryEvent onmatch="exclude"/>
    <FileDeleteDetected onmatch="exclude"/>
    <CreateRemoteThread onmatch="exclude"/><ProcessTampering onmatch="exclude"/>
    <WmiEvent onmatch="exclude"/>
    <ProcessAccess onmatch="include"><TargetImage condition="end with">\lsass.exe</TargetImage></ProcessAccess>
    <ImageLoad onmatch="include"/><FileDelete onmatch="include"/><ClipboardChange onmatch="include"/>
  </RuleGroup></EventFiltering>
</Sysmon>
